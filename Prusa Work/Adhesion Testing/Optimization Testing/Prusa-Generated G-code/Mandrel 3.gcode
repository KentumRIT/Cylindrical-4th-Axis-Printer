; external perimeters extrusion width = 0.45mm
; perimeters extrusion width = 0.45mm
; infill extrusion width = 0.45mm
; solid infill extrusion width = 0.45mm
; top infill extrusion width = 0.42mm
; support material extrusion width = 0.40mm
; first layer extrusion width = 0.50mm

M73 P0 R14
M73 Q0 S14
M201 X7000 Y7000 Z200 E2500 ; sets maximum accelerations, mm/sec^2
M203 X400 Y400 Z12 E100 ; sets maximum feedrates, mm / sec
M204 P4000 R1200 T5000 ; sets acceleration (P, T) and retract acceleration (R), mm/sec^2
M205 X8.00 Y8.00 Z2.00 E10.00 ; sets the jerk limits, mm/sec
M205 S0 T0 ; sets the minimum extruding and travel feed rate, mm/sec

M486 S0
M486 AStraight bar 5mm width 30mm length 15mm height.stl
M486 S-1

;TYPE:Custom
M17 ; enable steppers
M862.3 P "XL" ; printer model check
M862.5 P2 ; g-code level check
M862.6 P"Input shaper" ; FW feature check
M115 U6.2.6+8948
G90 ; use absolute coordinates
M83 ; extruder relative mode
; set print area
M555 X126 Y131.4 W30 H5
; inform about nozzle diameter


M862.1 T2 P0.4 A0 F0



; turn off unused heaters
M104 T0 S0	; first tool is only used for probing, so never needs to be heated
M104 T1 S0

M104 T3 S0
M104 T4 S0

M217 Z2 ; set toolchange z hop to 2mm, or zhop variable from slicer if higher

; Home XY
G28 XY

; try picking tools used in print
G1 F24000






; select probing tool (M0 disables tool mapping)
T0 S1 M0 L0 D0


; home Z with MBL tool
M84 E ; turn off E motor
G28 Z
G0 Z5 ; add Z clearance


; MBL
M84 E ; turn off E motor
G29 P1 X40 Y9 W280 H5		; full mesh is spaced from 0-360mm in X and Y 36 points each, so each step represents a change of 10.286mm
				; probed points are 12x12 spaced every 3 points on the full mesh starting at 1,1 on the full mesh
				; mandrels located at every other row, so Y = 10.29, 72, 133.71mm, ect.
				; max safe X position is 332
G29 P1 X40 Y71 W280 H5 C
G29 P1 X40 Y132 W280 H5 C
G29 P1 X40 Y194 W280 H5 C
G29 P1 X40 Y256 W280 H5 C
G29 P1 X40 Y317 W280 H5 C
G29 T				; serial print sparse mesh
G29 P3.2			; interpolate mesh
G29 P3.13			; extrapolate mesh
G29 A				; activate mesh
G29 T				; serial print filled in mesh
G1 Z10 F720			; move away in Z
G1 F24000
P0 S1 M0 L1 D0; park the tool (M0 disables tool mapping)

M104.1 T2 P16 Q16 S220
G1 Z150
M117 Put Mesh on Mandrels
G4 S5
M601

T2 S1 L0 D0; pick initial tool
G21 ; set units to millimeters
G90 ; use absolute coordinates
M83 ; use relative distances for extrusion
; Change Tool-1 -> Tool2 (layer -1)
G1 F21000
M73 P2 R13
M73 Q1 S14
T2 S1 L0 D0
;_TOOLCHANGE_END
M572 S0.03 ; Filament gcode

M142 S36 ; set heatbreak target temp
M109 S230 T2 ; set temperature and wait for it to be reached
M107
;LAYER_CHANGE
;Z:0.2
;HEIGHT:0.2
M486 S0
